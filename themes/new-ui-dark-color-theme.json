  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.phpdoc"
      ],
      "settings": {
        "foreground": "#b4b4b4",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.phpdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "name": "Documentation types stay quiet",
      "scope": [
        "entity.name.type.instance.jsdoc",
        "entity.name.type.instance.phpdoc",
        "comment.block.documentation entity.name.type",
        "comment.block.phpdoc entity.name.type"
      ],
      "settings": {
        "foreground": "#b4b4b4"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#baa7ff"
      }
    },
    {
      "name": "Declaration words",
      "scope": [
        "storage.type"
      ],
      "settings": {
        "foreground": "#ff8dcc"
      }
    },
    {
      "name": "Modifiers",
      "scope": [
        "storage.modifier",
        "keyword.other.modifier",
        "keyword.control.export",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#ff8dcc"
      }
    },
    {
      "name": "Operators including arrows, coalescing, optional access and assignments",
      "scope": [
        "keyword.operator",
        "storage.type.function.arrow",
        "punctuation.accessor.optional",
        "punctuation.separator.question-mark",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ff8dcc"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "support.constant.handlebars"
      ],
      "settings": {
        "foreground": "#75c7f0"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "meta.function entity.name.function",
        "meta.function.declaration entity.name.function",
        "meta.method.declaration entity.name.function"
      ],
      "settings": {
        "foreground": "#4ccce6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "User types, interfaces, enums, structs and traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.trait"
      ],
      "settings": {
        "foreground": "#e0dffe"
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "storage.type.primitive",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.numeric",
        "storage.type.string",
        "storage.type.boolean",
        "storage.type.built-in",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#c2f3ff"
      }
    },
    {
      "name": "Strings and characters",
      "scope": [
        "string",
        "constant.character"
      ],
      "settings": {
        "foreground": "#b1f1cb"
      }
    },
    {
      "name": "Escapes and interpolation boundaries",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff8dcc"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffe7b3"
      }
    },
    {
      "name": "Booleans and nullish values",
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffca16"
      }
    },
    {
      "name": "Named constants and enum members",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "variable.other.enummember",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#ffe7b3"
      }
    },
    {
      "name": "Local identifiers remain neutral",
      "scope": [
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#edeef0"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#edeef0"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#edeef0"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.scope-resolution",
        "support.other.namespace"
      ],
      "settings": {
        "foreground": "#b0b4ba"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator entity.name.function",
        "entity.name.function.decorator",
        "entity.name.type.annotation",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#e796f3"
      }
    },
    {
      "name": "Structural punctuation",
      "scope": [
        "punctuation.definition.block",
        "punctuation.section.block",
        "punctuation.section.group",
        "punctuation.section.parens",
        "punctuation.section.brackets",
        "punctuation.separator.comma",
        "punctuation.terminator.statement",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#b0b4ba"
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#baa7ff"
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c2f3ff"
      }
    },
    {
      "name": "HTML and JSX attribute names",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.tsx",
        "entity.other.attribute-name.js.jsx",
        "entity.other.attribute-name.js"
      ],
      "settings": {
        "foreground": "#edeef0"
      }
    },
    {
      "name": "HTML and JSX literal attribute values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html",
        "meta.tag.attributes string.quoted"
      ],
      "settings": {
        "foreground": "#baa7ff"
      }
    },
    {
      "name": "Strings inside JSX expressions",
      "scope": [
        "meta.embedded.expression string.quoted"
      ],
      "settings": {
        "foreground": "#b1f1cb"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#e0dffe"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name",
        "variable.css"
      ],
      "settings": {
        "foreground": "#c2f3ff"
      }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value",
        "keyword.other.unit",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#ffe7b3"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc"
      ],
      "settings": {
        "foreground": "#c2f3ff"
      }
    },
    {
      "name": "Rust lifetimes and attributes",
      "scope": [
        "storage.modifier.lifetime.rust",
        "entity.name.type.lifetime.rust",
        "meta.attribute.rust"
      ],
      "settings": {
        "foreground": "#e796f3"
      }
    },
    {
      "name": "Rust macros",
      "scope": [
        "entity.name.function.macro",
        "support.macro"
      ],
      "settings": {
        "foreground": "#e796f3"
      }
    },
    {
      "name": "PHP variables: neutral sigils",
      "scope": [
        "punctuation.definition.variable.php"
      ],
      "settings": {
        "foreground": "#edeef0"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e0dffe",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#75c7f0"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#edeef0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#edeef0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#b1f1cb"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3dd68c"
      }
    },
    {
      "name": "Diff removals",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff9592"
      }
    },
    {
      "name": "Diff changes",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ffca16"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff9592"
      }
    },
    {
      "name": "Deprecated syntax",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ff9592",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#b0b4ba"
    },
    "type": {
      "foreground": "#e0dffe"
    },
    "class": {
      "foreground": "#e0dffe"
    },
    "interface": {
      "foreground": "#e0dffe"
    },
    "struct": {
      "foreground": "#e0dffe"
    },
    "enum": {
      "foreground": "#e0dffe"
    },
    "typeParameter": {
      "foreground": "#e0dffe"
    },
    "type.defaultLibrary": {
      "foreground": "#c2f3ff"
